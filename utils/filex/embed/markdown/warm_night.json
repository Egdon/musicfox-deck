{
  "document": { "block_prefix": "\n", "block_suffix": "\n", "color": "#CBC4B6", "margin": 2 },
  "block_quote": { "indent": 1, "indent_token": "│ ", "color": "#9E978A" },
  "paragraph": {},
  "list": { "level_indent": 2 },
  "heading": { "block_suffix": "\n", "color": "#DDD6C9", "bold": true },
  "h1": { "prefix": "", "color": "#DDD6C9", "bold": true },
  "h2": { "prefix": "", "color": "#DDD6C9", "bold": true },
  "h3": { "prefix": "", "color": "#9E978A", "bold": true },
  "h4": { "prefix": "", "color": "#9E978A" },
  "h5": { "prefix": "", "color": "#9E978A" },
  "h6": { "prefix": "", "color": "#7A7368" },
  "text": {},
  "strikethrough": { "crossed_out": true },
  "emph": { "italic": true },
  "strong": { "bold": true, "color": "#DDD6C9" },
  "hr": { "color": "#544F47", "format": "\n────────\n" },
  "item": { "block_prefix": "· " },
  "enumeration": { "block_prefix": ". " },
  "task": { "ticked": "[✓] ", "unticked": "[ ] " },
  "link": { "color": "#93AC82", "underline": true },
  "link_text": { "color": "#CBC4B6", "bold": true },
  "image": { "color": "#93AC82", "underline": true },
  "image_text": { "color": "#9E978A", "format": "Image: {{.text}} →" },
  "code": { "prefix": " ", "suffix": " ", "color": "#D2714F", "background_color": "#1D1C19" },
  "code_block": { "color": "#CBC4B6", "margin": 2 },
  "table": { "color": "#CBC4B6" },
  "definition_list": {},
  "definition_term": {},
  "definition_description": { "block_prefix": "\n→ " },
  "html_block": {},
  "html_span": {}
}
